{
  "expo": {
    "name": "Upkeep",
    "slug": "upkeep",
    "version": "1.0.0",
    "scheme": "upkeep",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0d0d0d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.upkeep.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0d"
      },
      "package": "com.upkeep.app"
    },
    "extra": {
      "apiUrl": "http://localhost:8000"
    }
  }
}
